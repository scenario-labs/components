{
  "name": "@scenario-labs/components",
  "version": "0.1.0",
  "description": "Shared site tooling for the Scenario plug-ins: components-lib (the sites' look), the handbook builder, link-preview cards and the action that publishes a plug-in's site.",
  "license": "MIT",
  "private": true,
  "repository": "github:scenario-labs/components",
  "bin": {
    "components": "bin/components.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install chromium",
    "lint": "node --import tsx tools/lint.ts"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "type": "module"
}
